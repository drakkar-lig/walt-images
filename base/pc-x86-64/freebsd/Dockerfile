# FreeBSD WalT image for pc-x86-64 nodes.
# See README.md in this directory for the design of this image.
ARG OS_VERSION

# -- stage 1 --
# Build a qemu binary able to make freebsd binaries
# work properly with a Linux kernel (qemu bsd-user, built
# for Linux hosts), for "walt image shell", "walt image build",
# and the RUN instructions of this Dockerfile.
FROM ubuntu:24.04 AS qemu-builder
RUN apt update && \
    DEBIAN_FRONTEND=noninteractive \
    apt install -y libelf-dev python-is-python3 python3-pip \
                   python3-setuptools ninja-build pkg-config \
                   libglib2.0-dev git libbsd-dev libkqueue-dev
WORKDIR /root
RUN git clone https://github.com/rhelmot/qemu-bsd-user-l4b bsd-user && \
    cd bsd-user && \
    git checkout 73bc89ba65fcedfef7e18ccdf37ec05e3a599b44
# Apply our patches, in the order given by file "series"
# (some of them depend on previous ones).
COPY base/pc-x86-64/freebsd/qemu-patches/ /root/bsd-user/00-bsd-user/
WORKDIR /root/bsd-user
RUN for p in $(cat 00-bsd-user/series); do \
        echo "Applying $p"; \
        patch -p1 < 00-bsd-user/$p || exit 1; \
    done
WORKDIR /root/bsd-user/00-bsd-user
ENV CFLAGS="-Wno-error"
RUN ../configure --disable-system --static --target-list=x86_64-bsd-user
RUN ninja qemu-x86_64
RUN strip qemu-x86_64 && cp qemu-x86_64 /qemu-freebsd-execve

# -- stage 2 --
# Populate a freebsd root filesystem
FROM debian:trixie AS freebsd-builder
ARG OS_VERSION
ARG ARCH="amd64"
# Releases older than the supported ones are moved to archive.freebsd.org
# (the URL would be "https://download.freebsd.org/releases/${ARCH}/
# ${OS_VERSION}-RELEASE" for a supported release).
ENV REPO="https://archive.freebsd.org/old-releases/${ARCH}/${OS_VERSION}-RELEASE"
RUN apt update && \
    DEBIAN_FRONTEND=noninteractive \
    apt install -y wget xz-utils libarchive-tools
RUN mkdir -p /mnt/freebsd-root
WORKDIR /mnt/freebsd-root
# note: --numeric-owner is needed, otherwise bsdtar uses the IDs of the
# users and groups of this debian container when their name exists here
# (e.g., FreeBSD's uucp user is 66, but 10 on debian).
RUN wget -q -O - ${REPO}/base.txz | unxz | bsdtar x --numeric-owner
RUN wget -q -O - ${REPO}/kernel.txz | unxz | bsdtar x --numeric-owner
RUN wget -q -O - ${REPO}/ports.txz | unxz | bsdtar x --numeric-owner
RUN cp /etc/resolv.conf etc/
COPY --from=qemu-builder /qemu-freebsd-execve usr/sbin/
# in freebsd, /sys is a symlink to /usr/src/sys
# replace it with a directory, or podman run will fail
# to mount a filesystem on it.
RUN rm sys && mkdir sys
# add files usually generated by the installer
RUN dd if=/dev/random of=etc/hostid bs=4 count=1
RUN dd if=/dev/random of=boot/entropy bs=4096 count=1 && \
    chmod 600 boot/entropy
# prepare boot files for walt boot
COPY base/pc-x86-64/freebsd/files/walt-loader.conf \
     boot/loader.conf.d/walt.conf
RUN mkdir -p boot/pc-x86-64
WORKDIR /mnt/freebsd-root/boot/pc-x86-64
COPY base/pc-x86-64/freebsd/files/start.ipxe .
RUN ln -s ../pxeboot ../loader.efi .
# fix os files for walt-init & freebsd's init
WORKDIR /mnt/freebsd-root
RUN mkdir run && touch etc/fstab
RUN ln -s /usr/local/bin/busybox bin/busybox
RUN sed -i -e "s/onifconsole/onifexists/g" etc/ttys
COPY base/pc-x86-64/freebsd/files/walt-init-overrides bin/
COPY base/pc-x86-64/freebsd/files/walt-rc.conf etc/rc.conf

# -- stage 3 --
# Build /boot/pxeboot.lkrn, useful for virtual nodes.
# Virtual nodes cannot load freebsd's /boot/pxeboot
# directly as the value of qemu's "-kernel" option
# because it is actually a PXE NBP binary.
# We use this intermediate binary which is just
# iPXE compiled into a Linux kernel binary format.
FROM debian:trixie AS pxeboot-builder
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C

# Installing essential apps
RUN apt-get update && \
    apt-get install -y wget git make gcc \
    vim liblzma-dev extlinux

# Retrieve freebsd's pxeboot binary
COPY --from=freebsd-builder /mnt/freebsd-root/boot/pxeboot /root/
COPY base/pc-x86-64/freebsd/files/call-pxeboot.ipxe /root/

# Build ipxe with linux kernel image format
WORKDIR /root
RUN git clone https://github.com/ipxe/ipxe.git && cd ipxe && \
    git checkout v2.0.0
WORKDIR /root/ipxe/src
RUN nice make -j $(nproc) bin/ipxe.lkrn \
            EMBED=/root/call-pxeboot.ipxe,/root/pxeboot
RUN cp bin/ipxe.lkrn /pxeboot.lkrn

# -- stage 4 --
# Build the final freebsd image, relying on
# artifacts from previous stages.
FROM scratch
COPY --from=freebsd-builder /mnt/freebsd-root /
COPY --from=pxeboot-builder /pxeboot.lkrn /boot/pc-x86-64/
# RUN instructions run freebsd binaries through our qemu build
SHELL ["/usr/sbin/qemu-freebsd-execve", "/bin/sh", "-c"]
# Disable the kmods repo — it doesn't exist for 14.3-RELEASE
RUN mkdir -p /usr/local/etc/pkg/repos && \
    echo 'FreeBSD-kmods: { enabled: no }' \
        > /usr/local/etc/pkg/repos/FreeBSD-kmods.conf
# Initialize pkg and install packages
RUN ASSUME_ALWAYS_YES=yes pkg bootstrap && \
    ASSUME_ALWAYS_YES=yes pkg update && \
    ASSUME_ALWAYS_YES=yes pkg install vim bash git wget busybox && \
    rm -rf /var/cache/pkg/*
# note: "pkg clean -a" does not remove the downloaded packages in this
# environment (it prints "Nothing to do"), so we remove them with rm.
# specify which node models this image can handle
LABEL walt.node.models=pc-x86-64
# specify min walt server version needed
LABEL walt.server.minversion=11
# Indicate the binary interpreter for use in walt image shell
LABEL walt.image.bin.interpreter=/usr/sbin/qemu-freebsd-execve
# The default entrypoint should start the shell
ENTRYPOINT ["/usr/sbin/qemu-freebsd-execve"]
CMD ["/usr/local/bin/bash"]
WORKDIR /root
# Compile walt-list-hidden-whiteouts
# (for detecting removed files with "walt node save", at least
# when in the network-volatile boot mode.)
COPY base/pc-x86-64/freebsd/files/walt_list_hidden_whiteouts.c /root/
RUN cc -o /bin/walt-list-hidden-whiteouts walt_list_hidden_whiteouts.c && \
    rm walt_list_hidden_whiteouts.c
