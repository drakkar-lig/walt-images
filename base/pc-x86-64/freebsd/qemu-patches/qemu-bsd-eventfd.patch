+            if (!is_error(ret)) {
+                int fdflags = fcntl(newfd, F_GETFD, 0);
+                if (fdflags < 0 || fcntl(newfd, F_SETFD, fdflags | FD_CLOEXEC) < 0) {
+                    return get_errno(-1);
+                }
+            }
+#endif
+        } else {
+            ret = get_errno(safe_dup2(arg1, newfd));
+        }
+        return ret;
+    }
