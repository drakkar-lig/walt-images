@@ -142,7 +141,36 @@ static inline abi_long do_freebsd___specialfd(int type, abi_ulong req,
 
     return ret;
 #else
-    abort();
+    /* Linux: implement __specialfd using eventfd2() */
+    abi_long ret = -TARGET_EINVAL;
+
+    switch (type) {
+    case TARGET_SPECIALFD_EVENT: {
+        struct target_specialfd_eventfd *target_eventfd;
+        unsigned int initval;
+        int bsd_flags, linux_flags = 0;
+
+        if (!lock_user_struct(VERIFY_READ, target_eventfd, req, 0)) {
+            return -TARGET_EFAULT;
+        }
+        initval = tswap32(target_eventfd->initval);
+        bsd_flags = tswap32(target_eventfd->flags);
+        unlock_user_struct(target_eventfd, req, 0);
+
+        /* Translate FreeBSD EFD flags to Linux EFD flags:
+         * FreeBSD EFD_SEMAPHORE = 1 (same as Linux)
+         * FreeBSD EFD_NONBLOCK = O_NONBLOCK = 4
+         * FreeBSD EFD_CLOEXEC = O_CLOEXEC = 0x100000 */
+        if (bsd_flags & 1)        linux_flags |= 1;       /* EFD_SEMAPHORE */
+        if (bsd_flags & 4)        linux_flags |= 0x800;   /* EFD_NONBLOCK */
+        if (bsd_flags & 0x100000) linux_flags |= 0x80000; /* EFD_CLOEXEC */
+
+        ret = get_errno(syscall(SYS_eventfd2, initval, linux_flags));
+        break;
+    }
+    }
+
+    return ret;
 #endif
 }
 #endif /* __FreeBSD_version >= 1300037 */
