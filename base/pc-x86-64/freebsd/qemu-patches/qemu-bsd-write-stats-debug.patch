         break;
 
     case TARGET_FREEBSD_NR_pwrite: /* pwrite(2) */
@@ -721,6 +724,7 @@ static abi_long freebsd_syscall(void *cpu_env, int num, abi_long arg1,
 
     case TARGET_FREEBSD_NR_writev: /* writev(2) */
         ret = do_bsd_writev(arg1, arg2, arg3);
+        if ((int)arg1 < 3 && !is_error(ret)) { qemu_track_write_fd((int)arg1, (ssize_t)ret); }
         break;
 
     case TARGET_FREEBSD_NR_pwritev: /* pwritev(2) */
