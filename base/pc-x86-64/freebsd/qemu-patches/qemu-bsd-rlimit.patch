diff -ru a/bsd-user/bsd-proc.c b/bsd-user/bsd-proc.c
--- a/bsd-user/bsd-proc.c
+++ b/bsd-user/bsd-proc.c
@@ -37,7 +37,44 @@
  */
 int target_to_host_resource(int code)
 {
+#if defined(__linux__)
+    /*
+     * The numbering of resources differs between FreeBSD and Linux
+     * from RLIMIT_NPROC (7 on FreeBSD, 6 on Linux). Without this
+     * conversion, setrlimit(RLIMIT_NPROC, 0) of a FreeBSD program (pkg
+     * does this in its sandboxed fetch process) sets RLIMIT_NOFILE to 0
+     * on Linux, and the program can no longer open any file.
+     * Resources specific to FreeBSD return -1 (see the callers).
+     */
+    switch (code) {
+    case TARGET_RLIMIT_CPU:
+        return RLIMIT_CPU;
+    case TARGET_RLIMIT_FSIZE:
+        return RLIMIT_FSIZE;
+    case TARGET_RLIMIT_DATA:
+        return RLIMIT_DATA;
+    case TARGET_RLIMIT_STACK:
+        return RLIMIT_STACK;
+    case TARGET_RLIMIT_CORE:
+        return RLIMIT_CORE;
+    case TARGET_RLIMIT_RSS:
+        return RLIMIT_RSS;
+    case TARGET_RLIMIT_MEMLOCK:
+        return RLIMIT_MEMLOCK;
+    case TARGET_RLIMIT_NPROC:
+        return RLIMIT_NPROC;
+    case TARGET_RLIMIT_NOFILE:
+        return RLIMIT_NOFILE;
+    case TARGET_RLIMIT_AS:
+        return RLIMIT_AS;
+    default:
+        /* RLIMIT_SBSIZE, RLIMIT_NPTS, RLIMIT_SWAP, RLIMIT_KQUEUES,
+         * RLIMIT_UMTXP, or invalid */
+        return -1;
+    }
+#else
     return code;
+#endif
 }
 
 rlim_t target_to_host_rlim(abi_llong target_rlim)
