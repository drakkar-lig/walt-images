+#endif
     switch (resource) {
+#if defined(__linux__)
+    case RLIMIT_NLIMITS:
+        ret = 0;
+        break;
+#endif
     case RLIMIT_STACK:
         rlim.rlim_cur = target_dflssiz;
         rlim.rlim_max = target_maxssiz;
@@ -195,6 +211,25 @@
     struct target_rlimit *target_rlim;
     struct rlimit rlim;
 
+#if defined(__linux__)
+    if (resource == -1) {
+        /* resource specific to FreeBSD (see target_to_host_resource()) */
+        if (arg1 < 0 || arg1 > TARGET_RLIMIT_UMTXP) {
+            return -TARGET_EINVAL;
+        }
+        return 0;   /* ignored */
+    }
+    if (resource == RLIMIT_NPROC) {
+        /*
+         * On Linux, RLIMIT_NPROC limits the number of processes and
+         * threads of the real user ID, on the whole host, including the
+         * threads qemu creates for itself. A low value (e.g., 0, set by
+         * pkg to prevent its sandboxed process from forking) would make
+         * the emulation fail, so it is ignored.
+         */
+        return 0;
+    }
+#endif
     if (RLIMIT_STACK == resource) {
         /* XXX We should, maybe, allow the stack size to shrink */
         ret = -TARGET_EPERM;
