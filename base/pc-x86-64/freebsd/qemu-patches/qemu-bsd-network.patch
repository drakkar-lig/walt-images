+/*
+ * Translate FreeBSD address family constants to Linux equivalents.
+ * FreeBSD and Linux share many AF values but diverge significantly above AF_INET.
+ */
+static inline int bsd_to_linux_af(int bsd_af)
+{
+    /* FreeBSD AF constants that differ from Linux */
+    switch (bsd_af) {
+    case 10: return AF_INET; /* AF_CCITT in BSD, treat unknown as INET */
+    case 28: return AF_INET6; /* FreeBSD AF_INET6=28, Linux AF_INET6=10 */
+    case 17: return AF_NETLINK; /* FreeBSD AF_ROUTE=17, Linux AF_NETLINK=16 */
+    case 38: return AF_NETLINK; /* FreeBSD AF_NETLINK=38, Linux AF_NETLINK=16 */
+    default:
+        /* AF_UNIX=1, AF_INET=2, AF_APPLETALK=16(bsd)/5(linux) etc. */
+        /* For the common cases (AF_UNIX=1, AF_INET=2), values are the same */
+        return bsd_af;
+    }
+}
+
 /* socket(2) */
 static inline abi_long do_bsd_socket(abi_long domain, abi_long type,
                                      abi_long protocol)
 {
-    return get_errno(socket(domain, type, protocol));
+    int linux_domain = bsd_to_linux_af((int)domain);
+    return get_errno(socket(linux_domain, type, protocol));
 }
 
