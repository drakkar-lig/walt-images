+ * Translate ifi_flags in Linux RTM_NEWLINK netlink messages to FreeBSD format.
+ * Key differences:
+ *   IFF_MULTICAST: Linux=0x1000, FreeBSD=0x8000
+ *   IFF_LOWER_UP:  Linux=0x10000 == FreeBSD IFF_CANTCONFIG (causes match_if_flags to filter out ALL interfaces!)
+ *                  FreeBSD IFF_LOWER_UP (IFF_NETLINK_1) = 0x1000000
+ */
+static void translate_netlink_rtm_newlink(void *buf, size_t len)
+{
+    char *p = buf;
+    /* nlmsghdr is 16 bytes, ifinfomsg is 16 bytes */
+    while (len >= 16) {
+        uint32_t nlmsg_len  = ((uint32_t *)p)[0];
+        uint16_t nlmsg_type = ((uint16_t *)p)[2];
+        if (nlmsg_len < 16 || nlmsg_len > len)
+            break;
+        if (nlmsg_type == 16 /* RTM_NEWLINK */ && (int)(nlmsg_len - 16) >= 16) {
+            /* ifi_flags is at offset 16 (nlmsghdr) + 8 (ifi_family+pad+type+index) = 24 */
+            uint32_t *ifi_flags_ptr = (uint32_t *)(p + 24);
+            uint32_t flags = *ifi_flags_ptr;
+            /* Move IFF_MULTICAST from Linux bit 12 to FreeBSD bit 15 */
+            if (flags & 0x1000) { flags &= ~0x1000; flags |= 0x8000; }
+            /* Move IFF_LOWER_UP from Linux bit 16 to FreeBSD IFF_NETLINK_1 bit 24 */
+            if (flags & 0x10000) { flags &= ~0x10000; flags |= 0x1000000; }
+            *ifi_flags_ptr = flags;
+        }
+        uint32_t next = (nlmsg_len + 3) & ~3u;
+        p   += next;
+        len -= next;
+    }
