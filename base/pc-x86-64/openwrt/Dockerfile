ARG OS_TYPE
ARG OS_VERSION

# Step 1: build the root filesystem
# ---------------------------------
# note: this build is based on the one of featured/rpi32-chirpstack
# (chirpstack gateway OS is openwrt + a few patches).
FROM debian:trixie as openwrt-builder
ARG OS_VERSION
ARG OPENWRT_GIT="https://github.com/openwrt/openwrt.git"

# -- Install the packages we need for this build step --
RUN apt update && apt install -y \
        build-essential ca-certificates clang flex bison g++ gawk \
        gcc-multilib g++-multilib gettext git libncurses5-dev libssl-dev \
        python3 python3-setuptools rsync unzip zlib1g-dev file wget \
        quilt vim curl cpio zstd && \
        rm -f -r '/var/lib/apt/' && \
        rm -f -r '/var/cache/apt/'

# -- Fetch everything we need for the build --
# 1. openwrt git repo
RUN git clone --depth 1 --branch v${OS_VERSION} "${OPENWRT_GIT}" /root/openwrt
# 2. local files
COPY base/pc-x86-64/openwrt/build-files/make.sh \
     base/pc-x86-64/openwrt/build-files/openwrt.config /build-files/

# -- Compile openwrt --
WORKDIR /root/openwrt
RUN ./scripts/feeds update -a && \
    ./scripts/feeds install -a

# notes:
#
# In its default configuration, openwrt does not work properly on
# a network filesystem root. Initial work on this was done by
# Rémy Grunblatt and his conclusions are described at:
# https://forum.openwrt.org/t/preventing-the-init-to-mess-with-my-nfs-root-and-network/50357/8
#
# openwrt usually tries to reinit its network interfaces when booting up:
# 1. at preinit unless INITRAMFS env variable is set to 1
# 2. at preinit to handle failsafe mode unless failsafe mode is disabled
#    in menuconfig
# 3. when starting /etc/rc.d/S20network
#
# Reiniting walt network interface obviously causes issues with the network root
# filesystem. We can easily bypass 1 and 2 by providing the appropriate
# settings in the initramfs script and in menuconfig.
# Point 3 is harder to solve, because the service starts a binary
# called 'netifd' which reconfigures the interfaces when starting up,
# by making use of ioctl() calls. So we just ensure the walt network
# interface is not declared in /etc/config/network (see below).
#
# File build-files/openwrt.config contains only the changes comparing
# to the default configuration (packages pulled as dependencies are
# omitted, "make defconfig" selects them).
# (unlike chirpstack, the openwrt tree has no initial .config file,
# so we can just copy this file and let "make defconfig" expand it.)
RUN cp /build-files/openwrt.config .config && \
    make defconfig

# When compiling openwrt as the "root" user,
# FORCE_UNSAFE_CONFIGURE=1 is needed.
# See build-files/make.sh for how build errors are handled.
ARG FORCE_UNSAFE_CONFIGURE=1
RUN /build-files/make.sh tools/compile
RUN [ ! -f .error_detected ]
RUN /build-files/make.sh download
RUN [ ! -f .error_detected ]
RUN /build-files/make.sh toolchain/compile
RUN [ ! -f .error_detected ]
# File build-files/kernel-config contains the changes to the default
# kernel configuration of the target. It is applied last by openwrt
# (see LINUX_KCONFIG_LIST in include/target.mk).
# We add fuse and nfs client (v3, v4.1, v4.2) as builtin features in
# the kernel (works better than trying to use the separate kernel modules
# available from the global openwrt menuconfig, especially considering
# the several nfs versions), and expose the kernel config at
# /proc/config.gz, and disable microcode late loading (we do not want
# the CPU microcode to be updated at runtime on experimentation nodes).
# The file also lists the kernel options these
# changes make visible, for the kernel "oldconfig" step to run
# non-interactively.
# It can be regenerated by running:
# $ FORCE_UNSAFE_CONFIGURE=1 make kernel_menuconfig CONFIG_TARGET=env
# (this generates env/kernel-config)
COPY base/pc-x86-64/openwrt/build-files/kernel-config /root/openwrt/env/
# (this file is copied as late as possible to preserve the cache
# of previous build steps when it is modified.)
RUN /build-files/make.sh world
RUN [ ! -f .error_detected ]

# create image root filesystem
RUN mkdir /root/rootfs
WORKDIR /root/rootfs
RUN tar xf /root/openwrt/bin/targets/x86/64/openwrt-x86-64-generic-rootfs.tar.gz
WORKDIR /root/rootfs/dev
ADD base/pc-x86-64/openwrt/dev-content.tar.gz .
WORKDIR /root/rootfs
# The network service (netifd) and the firewall are kept enabled.
# However, the network interface connected to walt-net is configured by
# the initramfs (NFS root) and must not be managed by netifd, so it is
# not declared in /etc/config/network (see overlays/openwrt).
# Instead, the firewall zone 'walt' (accepting all traffic, since the
# node must remain reachable by the server) refers to its network
# device, which is detected at bootup by /etc/init.d/walt-net.
# (and since this interface is not declared in /etc/config/network,
# dnsmasq cannot serve DHCP on walt-net.)
COPY base/pc-x86-64/openwrt/firewall-walt-zone /root/
RUN cat /root/firewall-walt-zone >> etc/config/firewall
RUN mkdir -p etc/walt usr/bin run
COPY overlays/generic overlays/openwrt overlays/ipxe \
     overlays/spec-ipxe \
     overlays/pc /root/rootfs/
RUN ln -s ../init.d/walt-net etc/rc.d/S18walt-net
WORKDIR /root/rootfs/boot
RUN rm -f common-ipxe/start-generic-nbfs.ipxe  # kernel is too old for NBFS
RUN rm -f System.map-lts config-lts vmlinuz-lts initramfs-lts

# create initramfs
COPY base/pc-x86-64/openwrt/initrd_skeleton /root/initrd
RUN mkdir -p /root/initrd/sbin
COPY base/pc-x86-64/openwrt/create_initramfs.sh /root
RUN /root/create_initramfs.sh

# finalize image root filesystem
RUN cp /root/openwrt/bin/targets/x86/64/*-kernel.bin /root/initramfs.cpio.gz .
WORKDIR /root/rootfs/boot/common-pc
RUN ln -sf ../*-kernel.bin kernel
RUN ln -sf ../initramfs.cpio.gz initrd

# Step 2: Build the final image
# -----------------------------
FROM scratch
# specify which node models this image can handle
LABEL walt.node.models=pc-x86-64
# specify min walt server version needed
LABEL walt.server.minversion=5
# copy file tree prepared above
COPY --from=openwrt-builder /root/rootfs /
# set an entrypoint (handy when debugging)
ENTRYPOINT /bin/sh
